# training uses a SINGLE day's file (Friday: has the most attack types).
DATA_PATH="data/CICIDS2017_improved/friday.csv"
CLEANED_DIR="data/cleaned"
TEST_SIZE=0.2
RANDOM_STATE=42

SAVE_DATA=True

# reuse the cleaned/scaled cache instead of reprocessing the raw file every run.
# first run: processes Friday + writes the cache; later runs: load it (fast).
# IMPORTANT: if you change DATA_PATH, delete CLEANED_DIR (or set LOAD_CLEANED=False)
# once so the cache is rebuilt from the new data.
LOAD_CLEANED=True

# PLOTS_DIR=plots          # where figures are written (default: plots/)
# MODEL_DIR=models         # where trained agents + scaler/encoder are saved
